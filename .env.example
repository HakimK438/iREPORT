# Copy to .env in the repo root. docker compose reads it for the API container, and Vite reads VITE_* from it.
# When running the API on the host instead, export these variables or copy this file to backend/.env.
# Comments must stay on their own lines (docker --env-file does not strip inline comments).

# --- general ---
# development | test | production
ENV=development
DATABASE_URL=postgresql+asyncpg://ireport:ireport@localhost:5434/ireport
DB_POOL_SIZE=10

# --- auth ---
# openssl rand -hex 32
JWT_SECRET=replace-with-64-random-characters-from-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# true in production (HTTPS only)
COOKIE_SECURE=false
# lax | strict | none   (use none together with COOKIE_SECURE=true if the frontend is on another site)
COOKIE_SAMESITE=lax
# comma-separated list of frontend origins
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

# First admin account. Created at start-up only if no admin exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=System Admin

# --- object storage: MinIO locally, Cloudflare R2 or AWS S3 in production ---
# s3 | memory (memory is for tests only)
STORAGE_BACKEND=s3
# R2: <account-id>.r2.cloudflarestorage.com   S3: s3.ap-south-1.amazonaws.com
S3_ENDPOINT=localhost:9000
# host the browser uses for signed URLs (in compose the API talks to minio:9000 internally)
S3_PUBLIC_ENDPOINT=localhost:9000
# true for R2 / S3
S3_SECURE=false
# S3_PUBLIC_SECURE defaults to S3_SECURE
# S3_PUBLIC_SECURE=true
# R2: auto   S3: ap-south-1
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ireport
# false in production: create the bucket yourself, with no public access
S3_CREATE_BUCKET=true
SIGNED_URL_MINUTES=15

# --- uploads ---
MAX_UPLOAD_BYTES=8388608
MAX_PIXELS=25000000
MAX_PHOTOS=3
MAIN_MAX_SIDE=1280
THUMB_MAX_SIDE=400

# --- AI ---
MODELS_DIR=models
IMAGE_MODEL_NAME=img-1.0
TEXT_MODEL_NAME=txt-1.0
AI_UNCERTAIN_BELOW=0.60
AI_THREADS=2
# true: /ready returns 503 until the image model file is present
REQUIRE_IMAGE_MODEL=false

# --- merge rule ---
MERGE_RADIUS_M=50
MERGE_MAX_AGE_DAYS=14

# --- retention and jobs ---
# run the cleanup and priority jobs in this process (only one replica should)
ENABLE_SCHEDULER=true
DRAFT_TTL_MINUTES=60
FULL_IMAGE_RETENTION_DAYS=365

# --- rate limits (requests per minute per client) ---
RATE_LOGIN=10
RATE_REGISTER=5
RATE_ANALYZE=20

# --- frontend (Vite) ---
VITE_API_URL=http://localhost:8000/api/v1
